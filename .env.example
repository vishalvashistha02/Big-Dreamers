# =============================================================================
# Big Dreamers Environment Configuration Template
# Copy this file to .env and configure with your environment-specific credentials
# DO NOT COMMIT THE ACTUAL .env FILE TO VERSION CONTROL
# =============================================================================

# Database Configuration
DB_URL=jdbc:mysql://localhost:3306/big_dreamers?useSSL=false&serverTimezone=Asia/Kolkata&allowPublicKeyRetrieval=true
DB_USERNAME=your_username
DB_PASSWORD=your_password

# Server Configuration
SERVER_PORT=8080
